# Comic generation (compose profile "comic"). Copy to comic/.env.
GEMINI_API_KEY=
# Reads transcripts, writes scripts, checks lettering.
GEMINI_MODEL=gemini-3.8-flash
# Draws the comic pages.
GEMINI_IMAGE_MODEL=gemini-3-pro-image
# Output size of pages and sheets: 1K, 2K or 4K. Empty: the model's default (for a model that
# refuses the setting). For gemini-3-pro-image, 1K and 2K cost the same tokens.
GEMINI_IMAGE_SIZE=2K
# Seconds one comic step (e.g. drawing all pages) may take before it is cancelled.
JOB_TIMEOUT_SECONDS=3600
