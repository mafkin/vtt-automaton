# Copy to .env and fill in. All variables use the VTT_ prefix.
VTT_RULES_DB_PATH=data/pf2e_remaster.db
# One token per client (Foundry world, Discord bot), comma separated. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
VTT_CLIENT_TOKENS=
# Origin of the Molten-hosted Foundry, e.g. https://yourworld.moltenhosting.com
VTT_CORS_ORIGINS=
VTT_LLM_PROVIDER=gemini
VTT_GEMINI_API_KEY=
VTT_GEMINI_MODEL=gemini-2.5-flash
VTT_ANSWER_LANGUAGE=Finnish
# Max characters for rules text + ruling in one answer.
VTT_MAX_RULING_CHARS=3000
# Hours between checks for a new Archives of Nethys build (0 disables).
VTT_RULES_REFRESH_HOURS=24
