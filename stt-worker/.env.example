# Shared secret the Discord bot sends with each utterance.
STT_TOKEN=
# Backend address and a client token from the backend's VTT_CLIENT_TOKENS.
STT_BACKEND_URL=http://backend:8765
STT_BACKEND_TOKEN=
# Model: large-v3 for Finnish quality; "auto" uses the GPU when available.
STT_MODEL=large-v3
STT_DEVICE=auto
STT_COMPUTE_TYPE=default
STT_LANGUAGE=fi
# Beam search width: 5 is most accurate; 1 is roughly twice as fast if transcription lags behind.
STT_BEAM_SIZE=5
# Words Whisper should expect, comma separated: wake word, character and place names, game terms.
STT_PROMPT_TERMS=Nethys,Pathfinder,Strike,Stride,Step,Trip,Grapple,Shove,Demoralize,Reactive Strike,Shield Block,off-guard,prone,frightened,flanking,hit points,AC,DC
