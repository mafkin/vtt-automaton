{
  "name": "vtt-automaton-discord-bot",
  "private": true,
  "version": "0.1.0",
  "description": "Records a Discord voice channel per speaker for VTT Automaton session transcription",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
