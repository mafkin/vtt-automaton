# Discord application → Bot → Reset Token
DISCORD_TOKEN=
# Server ID (Discord: Settings → Advanced → Developer Mode, then right-click the server → Copy Server ID)
DISCORD_GUILD_ID=
# A client token from the backend's VTT_CLIENT_TOKENS
BACKEND_TOKEN=
# The STT worker's STT_TOKEN
STT_TOKEN=
# Stop recording when the voice channel has been empty this long
EMPTY_CHANNEL_MINUTES=5
