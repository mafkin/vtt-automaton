# Comic generation (compose profile "comic"). Copy to comic/.env.
GEMINI_API_KEY=
# Model for writing the comic script (beat sheet and panels).
GEMINI_MODEL=gemini-3.8-flash
# Seconds one comic job may take before it is cancelled.
JOB_TIMEOUT_SECONDS=14400
# How strongly a single-character panel follows that character's reference image (0-1), and
# the fraction of sampling steps it acts on. Higher values copy more of the whole picture.
IPADAPTER_WEIGHT=0.5
IPADAPTER_END_AT=0.8
